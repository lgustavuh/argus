<% var titulo = 'Alerta #' + alerta.id %>
<%- include('partials/head') %>
<% var ativo = 'alertas' %>
<%- include('partials/sidebar') %>

<a href="/alertas?status=abertos" class="btn ghost">&larr; voltar</a>

<div class="content-header">
    <h1 class="mono"><%= fmtCnj(alerta.numero_processo) %></h1>
    <span class="badge <%= alerta.status %>"><%= alerta.status %></span>
</div>

<% if (msg) { %><div class="msg-flash"><%= msg %></div><% } %>

<div class="card">
    <p><strong>Movimentação:</strong> <%= alerta.movimento_nome || '—' %> <span class="meta">(código TPU: <span class="mono"><%= alerta.codigo_tpu || '—' %></span>)</span></p>
    <p><strong>Data da movimentação:</strong> <%= fmtDataHora(alerta.movimento_data_hora) %></p>
    <% var sist = sistemaDoProcesso(alerta); %>
    <p><strong>Sistema:</strong> <%= sist ? sist.rotulo : 'não informado pelo DataJud' %></p>
    <p><strong>Responsável pelo processo:</strong> <%= alerta.procurador_nome || 'não definido' %></p>

    <dl class="trilha">
        <dt>Alerta criado</dt><dd><%= fmtDataHora(alerta.criado_em) %></dd>
        <dt>Visualizado</dt><dd><%= alerta.visualizado_em ? fmtDataHora(alerta.visualizado_em) + (alerta.visualizado_por_nome ? ' por ' + alerta.visualizado_por_nome : '') : '—' %></dd>
        <dt>Escalado</dt><dd><%= alerta.escalado_em ? fmtDataHora(alerta.escalado_em) + (alerta.escalado_para_nome ? ' para ' + alerta.escalado_para_nome : '') : '—' %></dd>
        <dt>Ciência</dt><dd><%= alerta.ciente_em ? fmtDataHora(alerta.ciente_em) + (alerta.ciente_por_nome ? ' por ' + alerta.ciente_por_nome : '') : '—' %></dd>
    </dl>

    <div class="filtros acoes">
        <% if (alerta.link_consulta_publica) { %>
        <a class="btn secondary" href="<%= alerta.link_consulta_publica %>" target="_blank" rel="noopener">Consultar no <%= sist ? sist.rotulo : 'sistema de origem' %></a>
        <% } else { linksAlternativos(alerta).forEach(function(l) { %>
        <a class="btn secondary" href="<%= l.url %>" target="_blank" rel="noopener">Consultar no <%= l.rotulo %></a>
        <% }) } %>
        <a class="btn secondary" href="/processos/<%= alerta.processo_id %>">Ver processo completo</a>
        <% if (alerta.status !== 'ciente' && pode('darCiencia')) { %>
        <form class="inline" method="post" action="/alertas/<%= alerta.id %>/ciencia" data-confirmar="Confirmar ciência desta movimentação? A ação fica registrada com seu nome.">
            <button type="submit">Dar ciência</button>
        </form>
        <% } %>
    </div>
    <% if (alerta.status !== 'ciente' && !pode('darCiencia')) { %>
    <p class="meta">Somente procuradores e advogados podem dar ciência.</p>
    <% } %>
</div>

<div class="card">
    <div class="card-title-row">
        <h2>Prazos lançados a partir deste alerta</h2>
        <% if (pode('gerenciarAgenda')) { %><a class="btn secondary" href="/agenda/novo?alertaId=<%= alerta.id %>">Registrar prazo</a><% } %>
    </div>
    <% if (compromissos.length) { %>
    <ul class="agenda-lista">
        <% compromissos.forEach(function(c) { %><%- include('partials/compromisso_linha', { c: c, ocultarProcesso: true }) %><% }) %>
    </ul>
    <% } else { %>
    <p class="meta">Nenhum prazo lançado. Se a movimentação abriu prazo, registre a data fatal na agenda: o responsável é avisado e o prazo aparece no painel até ser concluído.</p>
    <% } %>
</div>

<% if (historico.length) { %>
<div class="card">
    <h2>Histórico</h2>
    <table>
        <thead><tr><th>Quando</th><th>Quem</th><th>Ação</th></tr></thead>
        <tbody>
            <% historico.forEach(function(h) { %>
            <tr>
                <td class="meta"><%= fmtDataHora(h.criado_em) %></td>
                <td><%= h.usuario_nome || '—' %></td>
                <td><%= h.acao === 'alerta_ciencia' ? 'Deu ciência' : (h.acao === 'alerta_visualizado' ? 'Visualizou' : h.acao) %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } %>

<%- include('partials/foot') %>
