# ---------------------------------------------------------------------------
# Argus — variaveis de ambiente do servidor.
# Configuracoes de uso diario (e-mail, prazos, atualizacao automatica, MNI) ficam na tela
# Configuracoes do sistema, nao aqui.
# ---------------------------------------------------------------------------

# Senha do usuario "argus" do PostgreSQL (o docker-compose monta a DATABASE_URL com ela).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# Chave de assinatura das sessoes (JWT HS256). Minimo de 64 caracteres hexadecimais (256 bits);
# o recomendado e 128 (512 bits). NAO e um hash SHA-256 de uma frase — e um valor aleatorio:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Trocar esta chave encerra a sessao de todos os usuarios (todos fazem login de novo).
JWT_SECRET=

# Chave AES-256 para cifrar as senhas de SMTP/MNI salvas no banco: exatamente 64 caracteres hex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se for trocada, as senhas de SMTP/MNI precisam ser cadastradas de novo na tela.
ENCRYPTION_KEY=

# Chave publica da API do DataJud/CNJ: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=

PORT=3000
NODE_ENV=production
# Endereco usado nos links dos e-mails de alerta (ex.: http://192.168.0.10:3000 ou https://argus.prefeitura...).
APP_BASE_URL=http://localhost:3000

# true somente se a aplicacao estiver atras de HTTPS (proxy reverso com certificado). Em HTTP puro
# deixe false, senao o navegador nao envia o cookie de sessao e o login nao funciona.
COOKIE_SECURE=false
# Atras de proxy reverso, defina 1 para registrar o IP real do usuario (auditoria/bloqueio de login).
TRUST_PROXY=

# Quantos dias de backup diario do banco manter em ./backups.
BACKUP_RETENCAO_DIAS=30
